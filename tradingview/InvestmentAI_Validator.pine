//@version=6
indicator("InvestmentAI - TradingView Validator", overlay=true, max_labels_count=100)

// Controlled technical contract shared with InvestmentAI.
emaFastLength = input.int(9, "EMA Fast", minval=1)
emaSlowLength = input.int(21, "EMA Slow", minval=1)
bbLength = input.int(20, "Bollinger Period", minval=1)
bbMultiplier = input.float(2.0, "Bollinger Multiplier", minval=0.1, step=0.1)
rsiLength = input.int(14, "RSI Period", minval=1)
volumeLength = input.int(20, "Volume MA", minval=1)

emaFast = ta.ema(close, emaFastLength)
emaSlow = ta.ema(close, emaSlowLength)
bbBasis = ta.sma(close, bbLength)
bbDeviation = bbMultiplier * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDeviation
bbLower = bbBasis - bbDeviation
rsi14 = ta.rsi(close, rsiLength)
volumeMa = ta.sma(volume, volumeLength)

emaState = emaFast > emaSlow ? "bullish" : emaFast < emaSlow ? "bearish" : "neutral"
rsiState = rsi14 < 30 ? "oversold" : rsi14 > 70 ? "overbought" : "neutral"
bbState = close < bbLower ? "below_lower" : close > bbUpper ? "above_upper" : "inside"

plot(emaFast, "EMA 9")
plot(emaSlow, "EMA 21")
plot(bbUpper, "BB Upper")
plot(bbBasis, "BB Basis")
plot(bbLower, "BB Lower")

plotshape(ta.crossover(emaFast, emaSlow), title="EMA Bullish Cross", style=shape.triangleup, location=location.belowbar, size=size.tiny)
plotshape(ta.crossunder(emaFast, emaSlow), title="EMA Bearish Cross", style=shape.triangledown, location=location.abovebar, size=size.tiny)

var table dashboard = table.new(position.top_right, 2, 6)
if barstate.islast
    table.cell(dashboard, 0, 0, "InvestmentAI")
    table.cell(dashboard, 1, 0, "Validator")
    table.cell(dashboard, 0, 1, "EMA 9/21")
    table.cell(dashboard, 1, 1, emaState)
    table.cell(dashboard, 0, 2, "RSI 14")
    table.cell(dashboard, 1, 2, str.tostring(rsi14, "#.##") + " / " + rsiState)
    table.cell(dashboard, 0, 3, "BB 20/2")
    table.cell(dashboard, 1, 3, bbState)
    table.cell(dashboard, 0, 4, "Volume")
    table.cell(dashboard, 1, 4, volume > volumeMa ? "above_ma" : "below_ma")
    table.cell(dashboard, 0, 5, "Bar")
    table.cell(dashboard, 1, 5, barstate.isconfirmed ? "confirmed" : "open")

// Optional future webhook transport. It never submits orders.
// Create a TradingView alert using "Any alert() function call" when the account plan permits alerts.
if barstate.isconfirmed
    payload = "{" +
      "\"source\":\"tradingview\"," +
      "\"symbol\":\"" + syminfo.ticker + "\"," +
      "\"exchange\":\"" + syminfo.prefix + "\"," +
      "\"timeframe\":\"" + timeframe.period + "\"," +
      "\"bar_time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"," +
      "\"close\":" + str.tostring(close, "#.########") + "," +
      "\"ema_fast\":" + str.tostring(emaFast, "#.########") + "," +
      "\"ema_slow\":" + str.tostring(emaSlow, "#.########") + "," +
      "\"rsi14\":" + str.tostring(rsi14, "#.########") + "," +
      "\"bb_upper\":" + str.tostring(bbUpper, "#.########") + "," +
      "\"bb_basis\":" + str.tostring(bbBasis, "#.########") + "," +
      "\"bb_lower\":" + str.tostring(bbLower, "#.########") + "," +
      "\"volume\":" + str.tostring(volume, "#.########") + "," +
      "\"ema_state\":\"" + emaState + "\"," +
      "\"rsi_state\":\"" + rsiState + "\"," +
      "\"bb_state\":\"" + bbState + "\"," +
      "\"bar_confirmed\":true" +
      "}"
    alert(payload, alert.freq_once_per_bar_close)

alertcondition(ta.crossover(emaFast, emaSlow), "EMA Bullish Cross", "InvestmentAI EMA 9 crossed above EMA 21")
alertcondition(ta.crossunder(emaFast, emaSlow), "EMA Bearish Cross", "InvestmentAI EMA 9 crossed below EMA 21")
alertcondition(ta.crossunder(rsi14, 30), "RSI Entered Oversold", "InvestmentAI RSI 14 entered oversold")
alertcondition(ta.crossover(rsi14, 70), "RSI Entered Overbought", "InvestmentAI RSI 14 entered overbought")
