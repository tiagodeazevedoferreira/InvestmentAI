{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestmentAI Codex Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "changes",
    "tests",
    "results",
    "risks",
    "pending",
    "next_step",
    "commit"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DONE", "BLOCKED", "PARTIAL"]
    },
    "changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "results": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_step": { "type": "string" },
    "commit": { "type": "string" }
  }
}
