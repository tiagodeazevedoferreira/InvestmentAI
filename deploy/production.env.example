# InvestmentAI production runtime configuration template
# Copy into the hosting platform's runtime configuration. Do not commit real
# credentials, tokens, service-account JSON, private keys or broker passwords.

APP_NAME=InvestmentAI
ENVIRONMENT=production
TRADING_MODE=simulation

# External services / credentials: inject real values through the hosting
# platform's secret mechanism. Leave unset when the service is not required.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT=
TRADINGVIEW_WEBHOOK_SECRET=

# Research/runtime limits
MARKET_DATA_TIMEOUT_SECONDS=20
MAX_FIREBASE_WRITE_BYTES=900000
MODEL_MIN_PROBABILITY=0.65

# Trading safety defaults
LIVE_TRADING_ENABLED=false
MODEL_APPROVED=false
RISK_GATE_ENABLED=true

# Paper simulation
PAPER_INITIAL_CASH=100000
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=5
PAPER_ACCOUNT_PATH=paper/account
PAPER_MAX_ORDER_NOTIONAL=10000

# Model/runtime paths
XGBOOST_MODEL_DIR=models/xgboost

# HTTP/API hardening
# Replace '*' with the exact browser origins used by the deployed frontend.
CORS_ALLOWED_ORIGINS=*
# Prefer false in production unless interactive API documentation is explicitly required.
API_DOCS_ENABLED=false
LOG_LEVEL=INFO

# MT5/DOTO settings are intentionally unset in the Linux production container.
# The authenticated Windows DOTO/MT5 workstation remains a separate execution boundary.
DOTO_MT5_TERMINAL_PATH=
MT5_EXPECTED_LOGIN=
MT5_EXPECTED_SERVER=DOTOGlobal-Real
MT5_DEMO_EXECUTION_ENABLED=false
MT5_DEMO_EXPECTED_LOGIN=
MT5_DEMO_EXPECTED_SERVER=
